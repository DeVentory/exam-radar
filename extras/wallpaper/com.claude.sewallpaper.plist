<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.claude.sewallpaper</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__HOME__/Pictures/claude-wallpaper/make.py</string>
  </array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>1</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>1</integer></dict>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>__HOME__/Pictures/claude-wallpaper/error.log</string>
</dict></plist>
